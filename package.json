{
  "name": "custom-harness",
  "version": "0.1.0",
  "description": "Smithers-first durable outcome runner with compatible harness/workflow artifacts",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "web": "bun src/server.ts",
    "test": "bun test tests/",
    "typecheck": "bun tsc --noEmit",
    "probe:pi-agent": "bun scripts/probe-pi-agent.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@flue/cli": "^0.3.10",
    "@flue/sdk": "^0.3.10",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "smithers-orchestrator": "^0.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3",
    "prettier": "^3.8.3",
    "typescript": "^5.8.0"
  }
}
